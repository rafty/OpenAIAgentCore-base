{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 3,
  "items": {
    "type": "object",
    "required": ["project_id", "estimated_person_days", "actual_person_days", "duration_business_days", "role_actuals", "variance_reason", "outcome_quality", "schema_version"],
    "additionalProperties": false,
    "properties": {
      "project_id": {"type": "string", "pattern": "^HIST-[0-9]{3}$"},
      "estimated_person_days": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
      "actual_person_days": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
      "duration_business_days": {"type": "integer", "minimum": 1},
      "role_actuals": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["role", "person_days"],
          "additionalProperties": false,
          "properties": {
            "role": {"type": "string", "enum": ["PM", "AWS_ARCHITECT", "INFRA_ENGINEER"]},
            "person_days": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
          }
        }
      },
      "variance_reason": {"type": "string", "minLength": 1, "maxLength": 500},
      "outcome_quality": {"const": "ACCEPTED"},
      "schema_version": {"const": 1}
    }
  }
}
