{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["master_id", "service", "task_type", "unit", "person_days_per_unit", "role", "valid_from", "valid_to", "approval_status", "version", "schema_version"],
    "additionalProperties": false,
    "properties": {
      "master_id": {"type": "string", "pattern": "^EFFORT-[A-Z0-9-]+$"},
      "service": {"type": "string", "enum": ["EC2", "RDS", "CLOUDWATCH"]},
      "task_type": {"type": "string", "minLength": 1},
      "unit": {"type": "string", "enum": ["SERVICE", "INSTANCE", "DATABASE", "ALARM"]},
      "person_days_per_unit": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
      "role": {"type": "string", "enum": ["AWS_ARCHITECT", "INFRA_ENGINEER"]},
      "valid_from": {"type": "string", "format": "date"},
      "valid_to": {"type": "string", "format": "date"},
      "approval_status": {"const": "APPROVED"},
      "version": {"type": "integer", "minimum": 1},
      "schema_version": {"const": 1}
    }
  }
}
